<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <PawnKindDef Name="ESCP_CollegekindBase" Abstract="True">
        <race>Human</race>
        <defaultFactionDef>ESCP_Faction_CollegeOfWinterhold</defaultFactionDef>
        <useFactionXenotypes>true</useFactionXenotypes>
        <maxGenerationAge>70</maxGenerationAge>
        <minGenerationAge>18</minGenerationAge>
        <chemicalAddictionChance>0.02</chemicalAddictionChance>
        <invNutrition>2.7</invNutrition>
        <invFoodDef>MealSurvivalPack</invFoodDef>
        <disallowedTraits>
            <li>Nudist</li>
        </disallowedTraits>
        <pawnGroupDevelopmentStage>Adult</pawnGroupDevelopmentStage>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>ESCP_Backstory_College_Child</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>ESCP_Backstory_College_Mage</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
    </PawnKindDef>

    <PawnKindDef ParentName="ESCP_CollegekindBase">
        <defName>ESCP_Pawnkind_College_Apprentice</defName>
        <label>College apprentice</label>
        <combatPower>35</combatPower>
        <itemQuality>Normal</itemQuality>
        <weaponMoney>100~350</weaponMoney>
        <weaponTags>
            <li>SomeMelee</li>
        </weaponTags>
        <apparelMoney>250~550</apparelMoney>
        <techHediffsChance>0</techHediffsChance>
        <initialWillRange>1~3</initialWillRange>
        <initialResistanceRange>6~12</initialResistanceRange>
        <modExtensions>
            <li Class="ESCP.Core.Magic.PawnKindExtension_Spellcaster">
                <spells>
                    <li>ESCP_Spell_Firebolt</li>
                </spells>
                <randomSpells>
                    <li>ESCP_Spell_Healing</li>
                    <li>ESCP_Spell_Ward</li>
                </randomSpells>
                <randomCount>1~1</randomCount>
            </li>
        </modExtensions>
    </PawnKindDef>

